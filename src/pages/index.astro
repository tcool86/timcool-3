---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import About from '@/components/astro/About.astro';
import Projects from '@/components/astro/Projects.astro';
import Archive from '@/components/astro/Archive.astro';
import Contact from '@/components/astro/Contact.astro';
import Footer from '@/components/astro/Footer.astro';

import Landing from '@/components/react/Landing';
import Header from '@/components/react/Header';
import MobileHeader from '@/components/react/MobileHeader';
import ExperienceTabs from '@/components/react/ExperienceTabs';
import SessionPing from '@/components/react/SessionPing';
---

<BaseLayout>
	<Landing client:load />
	<Header client:idle />
	<MobileHeader client:idle />

	<Section id="about">
		<About />
	</Section>

	<Section id="experience">
		<ExperienceTabs client:visible />
	</Section>

	<Section id="projects">
		<Projects />
	</Section>

	<Section id="archive">
		<Archive />
	</Section>

	<Section id="contact">
		<Contact />
	</Section>

	<Footer />
	<SessionPing client:idle />
</BaseLayout>

<script>
	import { setSection, type SectionId } from '@/state/portfolio';

	const sections = document.querySelectorAll<HTMLElement>(
		'[data-section-id]'
	);

	let lastY = window.scrollY;

	const observer = new IntersectionObserver(
		(entries) => {
			const goingDown = window.scrollY >= lastY;
			lastY = window.scrollY;

			for (const entry of entries) {
				const el = entry.target as HTMLElement;
				if (entry.isIntersecting) {
					el.classList.add('is-in-view');
					el.classList.remove('is-out-up');
					const id = el.dataset.sectionId as SectionId | undefined;
					if (id) setSection(id);
				} else {
					el.classList.remove('is-in-view');
					if (!goingDown) {
						el.classList.add('is-out-up');
					} else {
						el.classList.remove('is-out-up');
					}
				}
			}
		},
		{ threshold: 0.15 }
	);

	for (const section of sections) observer.observe(section);
</script>
